# PostgreSQL Connection string (Required)
DATABASE_URL=postgres://user:password@localhost:5432/nftdb

# Alchemy Ethereum RPC endpoints (Required)
ALCHEMY_WSS_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ALCHEMY_HTTP_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Optional Server Settings
PORT=8080

# Optional IPFS Gateways (Comma separated list of gateways to rotate through)
# Defaults to: https://cloudflare-ipfs.com/ipfs/,https://gateway.pinata.cloud/ipfs/,https://nftstorage.link/ipfs/,https://w3s.link/ipfs/,https://4everland.io/ipfs/
IPFS_GATEWAYS=https://cloudflare-ipfs.com/ipfs/,https://gateway.pinata.cloud/ipfs/
